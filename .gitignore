# Build products
.build/
build/
DerivedData/
*.xcarchive
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/
xcuserdata/
*.xcuserstate

# Local reference material (third-party sources, research, Apple docs) — never committed
Reference/

# Interop tooling
Interop/node/node_modules/

# macOS
.DS_Store
.claude/
Tools/captures/

# Release output and secrets: never committed (Archive/mac-app/Tools/release.sh writes to build/release)
*.dmg
*.p12
*.cer
*.certSigningRequest
*private-key*
*sparkle*.key
ExportOptions.plist

# Camera Bridge OS helpers (linux/helpers): build output and npm installs; the image build keeps its copy in build/os-helpers
linux/helpers/*/out/
linux/helpers/*/node_modules/
linux/helpers/*/dl-*
