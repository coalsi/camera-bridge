#!/bin/bash
# Writes the console banner with the box's current addresses (/run/issue.d), for people who connect a monitor to a
# headless mini PC. Runs when the network comes up and every few minutes (camera-bridge-banner.timer).
set -euo pipefail
dir=/run/issue.d
mkdir -p "$dir"

{
    echo
    echo "Web UI:   http://camera-bridge.local"
    ip -4 -o addr show scope global 2>/dev/null | awk '{ split($4, a, "/"); printf "          http://%s   (%s)\n", a[1], $2 }'
    ip -4 -o addr show scope link 2>/dev/null | awk '{ split($4, a, "/"); printf "          http://%s   (%s, no router found)\n", a[1], $2 }'
    echo
} >"$dir/50-camera-bridge.issue.new"
mv -f "$dir/50-camera-bridge.issue.new" "$dir/50-camera-bridge.issue"
