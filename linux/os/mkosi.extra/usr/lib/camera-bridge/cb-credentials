#!/bin/bash
# Applies provisioning credentials passed by the hypervisor / systemd (see camera-bridge-credentials.service).
set -euo pipefail
export CB_TAG=camera-bridge-credentials
# shellcheck source=lib.sh
. /usr/lib/camera-bridge/lib.sh

cred="${CREDENTIALS_DIRECTORY:?no credentials directory}/cb.ssh.authorized_keys"
if [ -f "$cred" ]; then
    /usr/sbin/cb-system ssh-enable "$cred"
fi
