#!/bin/bash
# Decides whether this boot is good. camera-bridge-health.service runs it; boot-complete.target requires that service,
# and systemd-bless-boot only blesses the boot (stops the rollback countdown) when boot-complete.target is reached.
# After three boots that never get there, systemd-boot falls back to the previous system.
#
# Good means: the daemon's health endpoint says the bridge runs (200 {"ok": true}; it answers 503 while the engine starts, and for good
# when the engine cannot start: a version that cannot read its settings is not kept), and a minute later still says so without the
# daemon having been restarted once on this boot (a version whose daemon crashes on its trial boot is not kept; on a blessed system a crash is only
# restarted), avahi-daemon runs (HomeKit needs it) and the data partition accepts writes. A box without a network cable is still
# good: only localhost is checked.
#
# A boot that is not good does not wait for someone to switch the box off and on: the service's ExecStopPost runs
# `cb-health-check --after-failure`, which restarts the box when that leads somewhere (this version has tries left, or another
# version can start instead). A broken update so uses up its three tries in about a quarter of an hour, and the box comes back on
# the previous version by itself. When no other version can start (a first install whose only version fails), it stays up.
#
#   cb-health-check                  the check (safe to run by hand: it never restarts anything)
#   cb-health-check --after-failure  (ExecStopPost) restart the box after a failed check, when a restart can help
set -euo pipefail
export CB_TAG=camera-bridge-health
# shellcheck source=lib.sh
. /usr/lib/camera-bridge/lib.sh

url=${CB_HEALTH_URL:-http://127.0.0.1/api/v1/health}
attempts=${CB_HEALTH_ATTEMPTS:-40}      # 40 x (3 s + at most 3 s) = 4 minutes at most
delay=${CB_HEALTH_DELAY:-3}
settle=${CB_HEALTH_SETTLE:-60}          # then it must still answer, without a restart in between
EFIVARS=${CB_EFIVARS:-/sys/firmware/efi/efivars}
LOADER_GUID=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f   # systemd-boot's variables

fail() {
    cb_log "$1"
    cb_status health failed "$1"
    exit 1
}

# answers: the bridge runs (curl -f fails on the 503 of a bridge that is starting or failed).
answers() {
    local body
    body=$(curl -fsS --max-time 3 "$url" 2>/dev/null) && jq -e '.ok == true' >/dev/null 2>&1 <<<"$body"
}

check() {
    local ok=0 i restarts probe
    for ((i = 1; i <= attempts; i++)); do
        if answers; then ok=1; break; fi
        sleep "$delay"
    done
    [ "$ok" -eq 1 ] || fail "the bridge did not start (no healthy answer from $url)"

    sleep "$settle"
    answers || fail "the bridge stopped running (no healthy answer from $url)"
    restarts=$(systemctl show -p NRestarts --value camerabridged.service 2>/dev/null || true)
    [ "${restarts:-0}" = 0 ] || fail "the daemon was restarted $restarts times on this boot (it crashed or stopped answering)"

    systemctl is-active --quiet avahi-daemon.service || fail "avahi-daemon is not running"

    probe=$(mktemp "$CB_DATA/.health.XXXXXX") || fail "the data partition is not writable"
    rm -f "$probe"

    cb_log "boot is healthy (version $(cb_os_version))"
    cb_status health ok "boot is healthy"
}

# boot_count_name: the boot entry this boot counts against, as systemd-boot renamed it before starting it ("cb-os_0.1.130+2-1.efi"),
# from its LoaderBootCountPath variable; nothing on a boot that is not counted (a blessed version, or no systemd-boot).
boot_count_name() {
    local var=$EFIVARS/LoaderBootCountPath-$LOADER_GUID path
    [ -r "$var" ] || return 0
    # 4 bytes of attributes, then the path in UTF-16 (our file names are plain ASCII).
    path=$(tail -c +5 "$var" | tr -d '\000')
    printf '%s' "${path##*\\}"
}

# tries_left NAME: the tries an entry name has left ("+2-1.efi" -> 2); nothing for a name without a counter.
tries_left() {
    if [[ $1 =~ \+([0-9]+)(-[0-9]+)?\.efi$ ]]; then printf '%s' "${BASH_REMATCH[1]}"; fi
}

# restart_helps: a restart leads somewhere: this counted entry has tries left (it is tried again), or its tries are used up and another
# entry that is not used up can start instead (systemd-boot starts that one). Not on a boot that is not counted.
restart_helps() {
    local booted left esp f name
    booted=$(boot_count_name)
    [ -n "$booted" ] || return 1
    left=$(tries_left "$booted")
    [ -n "$left" ] || return 1
    [ "$left" -eq 0 ] || return 0
    esp=$(cb_esp) || return 1
    [ -n "$esp" ] || return 1
    for f in "$esp"/EFI/Linux/cb-os_*.efi; do
        [ -e "$f" ] || continue
        name=${f##*/}
        [ "$name" != "$booted" ] || continue
        [ "$(tries_left "$name")" != 0 ] || continue
        return 0
    done
    return 1
}

after_failure() {
    # systemd sets SERVICE_RESULT for ExecStopPost: "success", or why the check did not pass (exit-code, timeout, signal, ...).
    [ "${SERVICE_RESULT:-success}" != success ] || return 0
    if restart_helps; then
        cb_log "this boot is not healthy (${SERVICE_RESULT}); restarting the box, so it tries this version again or goes back to the previous one"
        systemctl reboot --no-block
    else
        cb_log "this boot is not healthy (${SERVICE_RESULT}), and no other version could start instead; staying up"
    fi
}

case ${1:-} in
    '') check ;;
    --after-failure) after_failure ;;
    *) cb_die "usage: cb-health-check [--after-failure]" ;;
esac
