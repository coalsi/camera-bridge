[Unit]
Description=Import provisioning credentials (SSH key for VMs and lab setups)
# For virtual machines and scripted installs only: a credential named cb.ssh.authorized_keys (QEMU:
# -smbios type=11,value=io.systemd.credential:cb.ssh.authorized_keys=ssh-ed25519\ AAAA...) enables SSH with that
# key. Real boxes have no credentials and this unit does nothing.
After=srv.mount camera-bridge-ssh.service
ConditionCredential=cb.ssh.authorized_keys

[Service]
Type=oneshot
ImportCredential=cb.*
ExecStart=/usr/lib/camera-bridge/cb-credentials

[Install]
WantedBy=multi-user.target
