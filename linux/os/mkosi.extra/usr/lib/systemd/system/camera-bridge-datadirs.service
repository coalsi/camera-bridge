[Unit]
Description=Create the Camera Bridge directories on the data partition
DefaultDependencies=no
Requires=srv.mount
After=srv.mount
Before=var-lib-camera\x2dbridge.mount var-log-journal.mount local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/camera-bridge/cb-datadirs
