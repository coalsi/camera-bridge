[Unit]
Description=Remove journals of old boots (machine-id changes every boot on a read-only root)
DefaultDependencies=no
After=var-log-journal.mount
Requires=var-log-journal.mount
Before=systemd-journal-flush.service

[Service]
Type=oneshot
ExecStart=/usr/lib/camera-bridge/cb-journal-prune

[Install]
WantedBy=sysinit.target
