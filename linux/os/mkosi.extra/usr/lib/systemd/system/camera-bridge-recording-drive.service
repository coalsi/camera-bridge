[Unit]
Description=Put the chosen recording drive in place for the engine
Documentation=https://github.com/coalsi/camera-bridge
DefaultDependencies=no
Requires=var-lib-camera\x2dbridge.mount
After=var-lib-camera\x2dbridge.mount local-fs.target
Before=camerabridged.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/cb-recording-drive --apply
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
