[Unit]
Description=Handle requests from the Camera Bridge web UI
StartLimitIntervalSec=10s
StartLimitBurst=100

[Service]
Type=oneshot
ExecStart=/usr/sbin/cb-system process-requests
# It only moves and checks small files; one that hangs must not hold every later request (a restart, a factory reset) for good.
TimeoutStartSec=30s
