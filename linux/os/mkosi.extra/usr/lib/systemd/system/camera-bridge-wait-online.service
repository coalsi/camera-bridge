[Unit]
Description=Wait for the network, Ethernet or Wi-Fi (at most 30 s)
Documentation=https://github.com/coalsi/camera-bridge
# network-online.target for the daemon and the update check. In place of systemd-networkd-wait-online (masked): that one sees only
# networkd's links (Ethernet), so a box on Wi-Fi (NetworkManager's) waited out its timeout on every boot and failed.
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-networkd.service NetworkManager.service
Before=network-online.target shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/camera-bridge/cb-wait-online 30
# A backstop: the script gives up after 30 s by itself. If it ever hung, the unit fails here and the daemon still starts
# (network-online.target only wants it).
TimeoutStartSec=60

[Install]
WantedBy=network-online.target
