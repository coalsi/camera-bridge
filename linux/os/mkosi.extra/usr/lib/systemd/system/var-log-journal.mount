[Unit]
Description=Persistent journal (bound from the data partition)
DefaultDependencies=no
Requires=srv.mount camera-bridge-datadirs.service
After=srv.mount camera-bridge-datadirs.service
Before=local-fs.target systemd-journal-flush.service
Conflicts=umount.target
Before=umount.target

[Mount]
What=/srv/journal
Where=/var/log/journal
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
