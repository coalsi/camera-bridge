#!/bin/bash
# cb-update: A/B updates for Camera Bridge OS.
#
#   cb-update status        show the update state (JSON)
#   cb-update check         look for a newer release on GitHub (os-v* tags); writes /run/camera-bridge/status/update.json
#   cb-update apply         download, verify and write the newest release into the idle root slot + the ESP; reboot to use it
#   cb-update auto          what the daily timer runs: does nothing unless automatic updates were enabled
#   cb-update boot          (every boot) notice a newer version that did not start (systemd-boot went back to this one)
#
# How it stays safe:
#   1. The download runs as the unprivileged user "cbupdate" in a sandbox (cb-update-fetch) and can write only its cache.
#   2. Before anything touches a partition, this root script re-verifies the minisign signature of SHA256SUMS with the
#      public key in /usr/share/camera-bridge/update-key.pub and the SHA-256 of each file, hashing the bytes while it copies
#      them into a root-only staging folder, so the files cannot change between the check and the write.
#   3. systemd-sysupdate writes only the idle root slot (never the running one) and a new UKI named cb-os_<v>+3.efi.
#      systemd-boot counts the three tries; systemd-bless-boot keeps the new version only if the boot turns out healthy.
#   4. A version whose tries ran out is remembered (/srv/system/update-failed) and never offered again; update.json says
#      "rolled-back" with its version. Only a newer one is offered.
#   5. Installing takes the lock of cb-system's heavy jobs: the daily run and the web page's "Update now" never write at once.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export CB_TAG=cb-update
# shellcheck source=../lib/camera-bridge/lib.sh
. /usr/lib/camera-bridge/lib.sh

PUBKEY=/usr/share/camera-bridge/update-key.pub
CACHE=/srv/update/cache
STAGE=/srv/update/stage
FETCH=/usr/lib/camera-bridge/cb-update-fetch
STATUS=update
FORCE=0
FAILED=$CB_SYSTEM/update-failed   # versions that were installed and did not start (one a line, the newest last)
LOCK=$CB_RUN/jobs/.lock           # the lock of cb-system's heavy jobs (HEAVY_JOBS)
VERSION_RE='^[0-9]+(\.[0-9]+)*$'

require_root() { [ "$(id -u)" -eq 0 ] || cb_die "run as root"; }

arch() {
    case $(uname -m) in
        x86_64) echo amd64 ;;
        aarch64) echo arm64 ;;
        *) cb_die "unsupported architecture $(uname -m)" ;;
    esac
}

key_is_placeholder() { grep -q 'PLACEHOLDER' "$PUBKEY" 2>/dev/null; }

# Run the download helper as cbupdate, sandboxed. Output of the helper goes to stdout, its messages to stderr.
run_fetch() {
    systemd-run --quiet --wait --pipe --collect \
        -p User=cbupdate -p Group=cbupdate \
        -p ProtectSystem=strict -p ReadWritePaths=/srv/update/cache -p PrivateTmp=yes -p PrivateDevices=yes \
        -p ProtectHome=yes -p NoNewPrivileges=yes -p ProtectKernelTunables=yes -p ProtectControlGroups=yes \
        -p RestrictAddressFamilies="AF_INET AF_INET6 AF_UNIX" -p RestrictNamespaces=yes -p LockPersonality=yes \
        -p CapabilityBoundingSet= -p MemoryMax=768M -p TasksMax=64 -p SystemCallFilter=@system-service \
        "$FETCH" "$@"
}

status() {
    local extra=${3:-}
    [ -n "$extra" ] || extra='{}'
    cb_status "$STATUS" "$1" "$2" "$extra"
}

current_version() { cb_os_version; }

# take_lock: the lock of cb-system's heavy jobs, without waiting; fails while another one runs. The web page's update job (cb-system
# run-job update-apply) holds it already and passes it down on descriptor 9.
take_lock() {
    if [ "$(readlink "/proc/$$/fd/9" 2>/dev/null)" != "$LOCK" ]; then
        mkdir -p "${LOCK%/*}"
        exec 9>>"$LOCK"
    fi
    flock -n 9
}

# entry_state VERSION: what the boot partition holds of VERSION: "failed" (its tries are used up: it did not start properly),
# "installed" (it waits for its first start, or it is a good one), or nothing.
entry_state() {
    local v=$1 esp f name state=""
    [[ $v =~ $VERSION_RE ]] || return 0
    esp=$(cb_esp) || true
    [ -n "$esp" ] && [ -d "$esp/EFI/Linux" ] || return 0
    for f in "$esp/EFI/Linux/cb-os_$v.efi" "$esp/EFI/Linux/cb-os_$v+"*.efi; do
        [ -e "$f" ] || continue
        name=${f##*/}
        if [[ $name =~ \+0(-[0-9]+)?\.efi$ ]]; then state=failed; else state=installed; fi
    done
    printf '%s' "$state"
}

# failed_versions: the remembered versions that did not start, oldest first.
failed_versions() { grep -E "$VERSION_RE" "$FAILED" 2>/dev/null || true; }

is_failed() { failed_versions | grep -qxF "$1"; }

# newest_failed: the newest remembered version that did not start and is newer than the running one; nothing when there is none.
newest_failed() {
    local current v newest=""
    current=$(current_version)
    [ "$current" != unknown ] || return 0
    while IFS= read -r v; do
        dpkg --compare-versions "$v" gt "$current" || continue
        if [ -z "$newest" ] || dpkg --compare-versions "$v" gt "$newest"; then newest=$v; fi
    done < <(failed_versions)
    printf '%s' "$newest"
}

# rolled_back_status FAILED [EXTRA]: update.json for a box that went back from version FAILED (EXTRA: more fields, a JSON object).
rolled_back_status() {
    local failed=$1 extra=${2:-'{}'} current
    current=$(current_version)
    status rolled-back "Version $failed did not start properly, so the box went back to version $current by itself. It will not be offered again; a newer version will be." \
        "$(jq -n --arg c "$current" --arg f "$failed" --argjson e "$extra" '$e + {current: $c, failedVersion: $f, updateAvailable: false, rebootRequired: false}')"
}

# A box on a beta (0.x) takes betas; from 1.0 on, only full releases. Sets CHANNEL to the fetcher's extra arguments.
set_channel() {
    CHANNEL=()
    case "$(current_version)" in 0.*) CHANNEL=(--beta) ;; esac
}

# check: sets LATEST and AVAILABLE. A version that already did not start on this box is never available; one that is installed and
# waits for the restart stays "installed" (the page keeps saying "restart to use it", not "install").
do_check() {
    local current latest_json latest available=false extra failed
    current=$(current_version)
    failed=$(newest_failed)
    status checking "looking for updates"
    set_channel
    if ! latest_json=$(run_fetch latest "${CHANNEL[@]}"); then
        status failed "could not reach the update server (is the box online?)" "$(jq -n --arg c "$current" '{current: $c, updateAvailable: false}')"
        return 1
    fi
    if [ -z "$latest_json" ]; then
        # The server answered, but no stable Camera Bridge OS version is published there yet (test versions are not offered).
        extra=$(jq -n --arg c "$current" '{current: $c, updateAvailable: false, checkedAt: (now | todate)}')
        if [ -n "$failed" ]; then rolled_back_status "$failed" "$extra"; else status current "you are up to date ($current); no newer version has been published" "$extra"; fi
        LATEST=""
        AVAILABLE=false
        return 0
    fi
    latest=$(jq -r .version <<<"$latest_json")
    if ! [[ $latest =~ $VERSION_RE ]]; then
        status failed "the update server named an odd version" "$(jq -n --arg c "$current" '{current: $c, updateAvailable: false}')"
        return 1
    fi
    if [ "$current" != "unknown" ] && dpkg --compare-versions "$latest" gt "$current"; then available=true; fi
    extra=$(jq -n --arg c "$current" --argjson a "$available" --argjson r "$latest_json" \
        '{current: $c, latest: $r.version, tag: $r.tag, updateAvailable: $a, releaseUrl: $r.url, notes: $r.notes, checkedAt: (now | todate)}')
    LATEST=$latest
    if [ "$available" = true ] && is_failed "$latest"; then
        cb_log "version $latest did not start on this box before; it is not offered again"
        available=false
        rolled_back_status "$latest" "$(jq '.updateAvailable = false' <<<"$extra")"
    elif [ "$available" = true ] && [ "$(entry_state "$latest")" = installed ]; then
        available=false
        status installed "version $latest is installed; restart to use it. If it does not start properly the box returns to $current by itself." \
            "$(jq --arg v "$latest" '. + {installedVersion: $v, updateAvailable: false, rebootRequired: true}' <<<"$extra")"
    elif [ "$available" = true ]; then
        status available "version $latest is available (you have $current)" "$extra"
    elif [ -n "$failed" ]; then
        rolled_back_status "$failed" "$extra"
    else
        status current "you are up to date ($current)" "$extra"
    fi
    AVAILABLE=$available
}

verify_and_stage() {
    # verify_and_stage VERSION: re-verify the signature and hashes as root and copy the files into the root-only stage.
    local version=$1 a dir name want got uki root
    a=$(arch)
    dir=$CACHE/$version
    uki="cb-os_${version}_${a}.efi"
    root="cb-os_${version}_${a}_root.raw.zst"

    key_is_placeholder && cb_die "this image has no update signing key (a development build); updates are disabled"
    if [ ! -d "$dir" ] || [ -L "$dir" ]; then cb_die "nothing downloaded for $version"; fi

    find "$STAGE" -mindepth 1 -delete
    # Copy the list and its signature first, then verify the copies (the cache is owned by an unprivileged user).
    cat -- "$dir/SHA256SUMS" >"$STAGE/SHA256SUMS"
    cat -- "$dir/SHA256SUMS.sig" >"$STAGE/SHA256SUMS.sig"
    minisign -V -q -p "$PUBKEY" -m "$STAGE/SHA256SUMS" -x "$STAGE/SHA256SUMS.sig" || cb_die "signature check FAILED; refusing to install"

    for name in "$uki" "$root"; do
        want=$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' "$STAGE/SHA256SUMS")
        [ -n "$want" ] || cb_die "$name is not in the signed list"
        # Hash exactly the bytes that are written to the stage.
        got=$(tee "$STAGE/$name" <"$dir/$name" | sha256sum | cut -d' ' -f1)
        [ "$got" = "$want" ] || cb_die "SHA-256 mismatch for $name; refusing to install"
    done

    # Names the sysupdate transfer definitions expect (no architecture in them).
    mv "$STAGE/$uki" "$STAGE/cb-os_${version}.efi"
    zstd -d -q --sparse -f "$STAGE/$root" -o "$STAGE/cb-os_${version}_root.raw"
    rm -f "$STAGE/$root"
}

do_apply() {
    local version avail_kb need_kb
    do_check || return 1
    if [ "$AVAILABLE" != true ] && [ "$FORCE" != 1 ]; then
        case $(jq -r '.state' "$CB_STATUS/$STATUS.json" 2>/dev/null) in
            installed) cb_log "version $LATEST is installed already; restart to use it" ;;
            rolled-back) cb_log "nothing to install: the newest version did not start on this box before" ;;
            *) cb_log "already up to date" ;;
        esac
        return 0
    fi
    if [ -z "$LATEST" ]; then
        cb_log "no version has been published; nothing to install"
        return 0
    fi
    version=$LATEST
    [[ $version =~ $VERSION_RE ]] || cb_die "odd version string"

    avail_kb=$(df --output=avail -k /srv | tail -1 | tr -d ' ')
    need_kb=$((4 * 1024 * 1024))
    if [ "$avail_kb" -lt "$need_kb" ]; then
        status failed "not enough free space on the data partition (4 GB needed)"
        return 1
    fi

    status downloading "downloading version $version" "$(jq -n --arg v "$version" '{latest: $v}')"
    set_channel
    if ! run_fetch download "$version" "$(arch)" "${CHANNEL[@]}"; then
        status failed "download or verification of version $version failed"
        return 1
    fi

    status installing "verifying and installing version $version" "$(jq -n --arg v "$version" '{latest: $v}')"
    if ! (verify_and_stage "$version"); then
        status failed "verification of version $version failed; nothing was installed"
        find "$STAGE" -mindepth 1 -delete 2>/dev/null || true
        return 1
    fi

    if ! /usr/lib/systemd/systemd-sysupdate --definitions=/usr/lib/sysupdate.d --verify=no update "$version"; then
        status failed "writing version $version failed; the running system is untouched"
        find "$STAGE" -mindepth 1 -delete 2>/dev/null || true
        return 1
    fi
    find "$STAGE" -mindepth 1 -delete 2>/dev/null || true
    find "$CACHE" -mindepth 1 -delete 2>/dev/null || true
    sync
    status installed "version $version is installed; restart to use it. If it does not start properly the box returns to $(current_version) by itself." \
        "$(jq -n --arg v "$version" --arg c "$(current_version)" '{current: $c, latest: $v, installedVersion: $v, rebootRequired: true}')"
    cb_log "installed $version; reboot to activate"
}

# The bridge's time zone (Settings > Time zone, in the daemon's config.json), when it names one this system knows. The system
# clock itself stays on UTC.
bridge_time_zone() {
    local zone
    zone=$(jq -r '.settings.timeZone // empty' "$CB_DATA/config.json" 2>/dev/null) || return 0
    case "$zone" in ''|*[!A-Za-z0-9_+/-]*|/*|*..*) return 0 ;; esac
    [ -f "/usr/share/zoneinfo/$zone" ] && printf '%s' "$zone"
}

schedule_reboot() {
    # After an automatic update, restart in the quiet hour: 03:00 in the bridge's time zone (UTC when it has none).
    if systemctl is-active --quiet camera-bridge-update-reboot.timer; then return 0; fi
    local zone
    zone=$(bridge_time_zone)
    systemd-run --quiet --unit=camera-bridge-update-reboot --on-calendar="*-*-* 03:00:00 ${zone:-UTC}" \
        --timer-property=AccuracySec=1min systemctl reboot
    cb_log "restart scheduled for 03:00 ${zone:-UTC}"
}

do_auto() {
    if ! take_lock; then
        # The web page's "Update now" (or another heavy job) runs: its update.json is left alone, and the next daily run looks again.
        cb_log "another system job is running; the daily update check waits for tomorrow"
        return 0
    fi
    if [ ! -e "$CB_SYSTEM/auto-update" ]; then
        cb_log "automatic updates are off; only checking"
        do_check || true
        return 0
    fi
    do_apply || return 1
    if [ "$(jq -r '.state' "$CB_STATUS/$STATUS.json" 2>/dev/null)" = "installed" ]; then
        schedule_reboot
    fi
}

# remember_failed VERSION: adds it to the versions that did not start (the last 10 are kept).
remember_failed() {
    local v=$1
    is_failed "$v" && return 0
    install -d -m 0755 "$CB_SYSTEM"
    { failed_versions; printf '%s\n' "$v"; } | tail -n 10 >"$FAILED.new"
    chmod 0644 "$FAILED.new"
    mv -f "$FAILED.new" "$FAILED"
    cb_log "version $v did not start properly, so the box went back to $(current_version); it is not offered again"
}

# boot (camera-bridge-update-boot.service, every boot): a newer version whose tries are used up (cb-os_<v>+0-<n>.efi) did not start, and
# systemd-boot went back to this one. It is remembered and update.json says so. Versions at or below the running one are forgotten: this
# box runs one at least as new.
do_boot() {
    local current esp f name v keep
    current=$(current_version)
    [ "$current" != unknown ] || return 0
    esp=$(cb_esp) || true
    if [ -n "$esp" ] && [ -d "$esp/EFI/Linux" ]; then
        for f in "$esp"/EFI/Linux/cb-os_*+0.efi "$esp"/EFI/Linux/cb-os_*+0-*.efi; do
            [ -e "$f" ] || continue
            name=${f##*/}
            v=${name#cb-os_}
            v=${v%%+*}
            [[ $v =~ $VERSION_RE ]] || continue
            dpkg --compare-versions "$v" gt "$current" || continue
            remember_failed "$v"
        done
    fi
    if [ -s "$FAILED" ]; then
        keep=$(failed_versions | while IFS= read -r v; do if dpkg --compare-versions "$v" gt "$current"; then printf '%s\n' "$v"; fi; done)
        if [ -z "$keep" ]; then rm -f "$FAILED"; elif [ "$keep" != "$(failed_versions)" ]; then printf '%s\n' "$keep" >"$FAILED.new" && mv -f "$FAILED.new" "$FAILED"; fi
    fi
    v=$(newest_failed)
    if [ -n "$v" ]; then rolled_back_status "$v"; fi
}

main() {
    local cmd=${1:-}
    shift || true
    [ "${1:-}" = "--force" ] && FORCE=1
    LATEST=""; AVAILABLE=false
    case $cmd in
        status) cat "$CB_STATUS/$STATUS.json" 2>/dev/null || echo '{"state":"unknown"}' ;;
        check)  require_root; do_check ;;
        apply)  require_root; take_lock || cb_die "another system job is running; try again when it has finished"; do_apply ;;
        auto)   require_root; do_auto ;;
        boot)   require_root; do_boot ;;
        ''|-h|--help|help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' ;;
        *) cb_die "unknown command: $cmd" ;;
    esac
}

main "$@"
