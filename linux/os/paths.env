# The one place that says where the daemon, the web UI and the helpers live inside the image.
# build.sh reads this file, renders units/camerabridged.service.in with these values and installs the files there.
CB_DAEMON=/usr/bin/camerabridged
CB_WEB_ROOT=/usr/share/camera-bridge/web
# Helper programs the engine starts (go2rtc): one of the folders PlatformLinux's ProcessHelperLauncher searches.
CB_HELPERS_DIR=/usr/lib/camera-bridge/helpers
