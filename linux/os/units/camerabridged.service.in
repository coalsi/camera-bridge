# Rendered by build.sh: @CB_DAEMON@ and @CB_WEB_ROOT@ come from linux/os/paths.env (one place to change them).
[Unit]
Description=Camera Bridge engine and web UI
Documentation=https://github.com/coalsi/camera-bridge
After=network-online.target avahi-daemon.service camera-bridge-firstboot.service camera-bridge-factory-reset.service chrony.service
Wants=network-online.target avahi-daemon.service
Requires=camera-bridge-firstboot.service
RequiresMountsFor=/var/lib/camera-bridge
ConditionPathExists=@CB_DAEMON@
# Never given up on: a daemon that crashes is started again, at first after 3 s, then after longer pauses (at most 2 minutes) while it
# keeps crashing. A camera that crashes it must never end recording until someone restarts the box. Whether a new version is kept is
# the boot health check's call (cb-health-check: on its trial boot the daemon may not be restarted once), not a start limit here. The
# pause grows with the restarts of this boot; cb-system housekeeping forgets them once the daemon has run for half an hour.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=@CB_DAEMON@
Restart=always
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=120
# The daemon must send WATCHDOG=1 (sd_notify) at least every WatchdogSec/2.
WatchdogSec=30
TimeoutStartSec=120
TimeoutStopSec=30

User=camerabridge
Group=camerabridge
SupplementaryGroups=video render

# Where things are. The daemon reads these (documented in linux/os/README.md).
Environment=CAMERABRIDGE_PLATFORM=linux-os
Environment=CAMERABRIDGE_DATA_DIR=/var/lib/camera-bridge
Environment=CAMERABRIDGE_WEB_ROOT=@CB_WEB_ROOT@
Environment=CAMERABRIDGE_HTTP_PORT=80
Environment=CAMERABRIDGE_RUN_DIR=/run/camera-bridge
Environment=CAMERABRIDGE_OS_REQUEST_DIR=/run/camera-bridge/requests
Environment=CAMERABRIDGE_OS_STATUS_DIR=/run/camera-bridge/status
Environment=HOME=/var/lib/camera-bridge
Environment=TMPDIR=/tmp
# A crash prints the Swift backtrace (function names) to the journal, with the runtime's own helper; nothing is written to disk.
# registers=none: no register values or the memory they point at are printed (they could hold passwords or keys). images=none: shorter.
Environment=SWIFT_BACKTRACE=enable=yes,swift-backtrace=/usr/libexec/swift/linux/swift-backtrace-static,interactive=no,color=no,output-to=stderr,threads=all,registers=none,images=none
EnvironmentFile=-/etc/camera-bridge/camerabridged.env
WorkingDirectory=/var/lib/camera-bridge

# Hardening: the daemon can write its data directory and drop request files, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/camera-bridge /run/camera-bridge/requests
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
# No PrivateDevices: ffmpeg needs the GPU render node for VA-API. Everything else in /dev stays closed.
DevicePolicy=closed
DeviceAllow=char-drm rw
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Recordings are aged only once the kernel says the clock is synchronized: the daemon reads that with adjtimex(2), which glibc makes with
# clock_adjtime; both are outside @system-service. Reading needs no privilege. Setting the clock with them needs CAP_SYS_TIME, which the daemon
# never has (an unprivileged user, NoNewPrivileges, the bounding set below), and the calls that only set it (clock_settime, settimeofday) stay
# refused. So there is no ProtectClock=: it would refuse the read as well.
SystemCallFilter=adjtimex clock_adjtime
SystemCallErrorNumber=EPERM
# Port 80 without root.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077
LimitNOFILE=65536
OOMScoreAdjust=-300
# Its helpers (ffmpeg, go2rtc, the eufy and Wyze helpers) share the OOM protection above, so a leak among them would make the kernel pick
# avahi, NetworkManager, nginx or journald instead. Bounded: above 80% of the memory the bridge's own pages (mostly the recordings' file cache) are reclaimed first, and at 90%
# the out-of-memory kill happens inside the bridge (Restart= brings it back) and the rest of the box keeps running.
MemoryHigh=80%
MemoryMax=90%
# The bridge comes first on its own box: the most CPU and disk share when anything else (an update, the journal) competes.
CPUWeight=1000
IOWeight=1000

[Install]
WantedBy=multi-user.target
